#!/usr/bin/env bash
# krono-cli — stream and track TV shows from the terminal
# github.com/waxburned/krono-cli

# ── config ──────────────────────────────────────────────────────────────────
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do _src="$(readlink "$_src")"; done
SCRIPT_DIR="$(cd "$(dirname "$_src")" && pwd)"
HISTORY_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/krono-cli/history.tsv"
ANIME_HISTORY_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/krono-cli/anime_history.tsv"
MAL_TOKEN_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/krono-cli/mal_token.json"
ANILIST_TOKEN_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/krono-cli/anilist_token.json"
VIDEASY_API="https://api.videasy.to"
CINEBY_REF="https://www.cineby.at/"
ALLANIME_REF="https://youtu-chan.com"
PLAYER="${KRONO_PLAYER:-mpv}"
QUALITY="${KRONO_QUALITY:-1080p}"
PICK_SOURCE=0
ANIME_MODE=0
DUB_MODE=0

mkdir -p "$(dirname "$HISTORY_FILE")"
[[ ! -f "$HISTORY_FILE" ]] && touch "$HISTORY_FILE"
[[ ! -f "$ANIME_HISTORY_FILE" ]] && touch "$ANIME_HISTORY_FILE"

# ── helpers ──────────────────────────────────────────────────────────────────
die()  { printf '\e[31mERROR\e[0m: %s\n' "$*" >&2; exit 1; }
info() { printf '\e[36m→\e[0m %s\n' "$*" >&2; }
dep_check() {
    for d in fzf mpv node curl python3; do
        command -v "$d" &>/dev/null || die "Missing dependency: $d"
    done
}

# ── TMDB search ──────────────────────────────────────────────────────────────
tmdb_search() {
    local query="$1"
    local encoded_query
    encoded_query=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")
    curl -s \
        -A "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36" \
        "https://www.themoviedb.org/search/tv?query=${encoded_query}" \
    | python3 "$SCRIPT_DIR/tmdb_search.py" tv
}

tmdb_movie_search() {
    local query="$1"
    local encoded_query
    encoded_query=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")
    curl -s \
        -A "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36" \
        "https://www.themoviedb.org/search/movie?query=${encoded_query}" \
    | python3 "$SCRIPT_DIR/tmdb_search.py" movie
}

# ── URL verification ──────────────────────────────────────────────────────────
_verify_url() {
    local url="$1" referer="${2:-$CINEBY_REF}"
    local verify_tmp; verify_tmp=$(mktemp /tmp/krono_verify.XXXXXX)
    local status
    status=$(curl -s --max-time 8 \
        -H "Referer: $referer" \
        -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:151.0) Gecko/20100101 Firefox/151.0" \
        -o "$verify_tmp" -w "%{http_code}" \
        "$url" 2>/dev/null)
    if ! [[ "$status" =~ ^(200|206|301|302)$ ]]; then
        rm -f "$verify_tmp"; return 1
    fi
    if [[ "$url" == *.m3u8* ]]; then
        local manifest; manifest=$(cat "$verify_tmp")
        if ! [[ "$manifest" == *"#EXTM3U"* ]]; then
            rm -f "$verify_tmp"; return 1
        fi
        local child; child=$(printf '%s\n' "$manifest" | grep -v '^#' | grep -v '^$' | head -1)
        if [[ -n "$child" ]]; then
            if [[ "$child" != http* ]]; then
                local base="${url%%\?*}"; base="${base%/*}"
                child="${base}/${child}"
            fi
            local child_status
            child_status=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
                -H "Referer: $referer" \
                -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:151.0) Gecko/20100101 Firefox/151.0" \
                "$child" 2>/dev/null)
            [[ "$child_status" =~ ^(200|206)$ ]] || { rm -f "$verify_tmp"; return 1; }
        fi
    fi
    rm -f "$verify_tmp"
}

# ── fetch & decrypt stream ────────────────────────────────────────────────────
_build_params() {
    local tmdb_id="$1" media_type="$2" season="$3" episode="$4" imdb_id="$5" title="$6" year="$7"
    local params="tmdbId=${tmdb_id}&mediaType=${media_type}"
    local sid="${season:-1}" eid="${episode:-1}"
    params+="&seasonId=${sid}&episodeId=${eid}"
    [[ -n "$imdb_id" ]] && params+="&imdbId=${imdb_id}"
    if [[ -n "$title" ]]; then
        local enc_title
        enc_title=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$title")
        params+="&title=${enc_title}"
    fi
    [[ -n "$year" ]] && params+="&year=${year}"
    echo "$params"
}

_decrypt_response() {
    local ct_file="$1" tmdb_id="$2"
    node "$SCRIPT_DIR/decrypt.js" "$ct_file" "$tmdb_id" 2>/dev/null
}

get_imdb_id() {
    local tmdb_id="$1" media_type="${2:-tv}"
    curl -s -A "Mozilla/5.0" "https://www.themoviedb.org/${media_type}/${tmdb_id}" 2>/dev/null \
        | python3 -c "
import sys, re
m = re.search(r'href=\"https://www\.imdb\.com/title/(tt[0-9]+)', sys.stdin.read())
print(m.group(1) if m else '')
"
}

# Parse "Show Name (2026)" → sets $title and $year in caller scope
_parse_name() {
    local name="$1"
    year=""
    title="$name"
    if [[ "$name" =~ \(([0-9]{4})\)$ ]]; then
        year="${BASH_REMATCH[1]}"
        title="${name% \(${year}\)}"
    fi
}

# ── probe provider (stream + subtitle in one API call) ────────────────────────
# outputs: "stream_url\nsub_url" or nothing if provider unavailable
_probe_provider() {
    local provider="$1" tmdb_id="$2" media_type="$3" season="$4" episode="$5" imdb_id="$6" title="$7" year="$8"
    local params
    params=$(_build_params "$tmdb_id" "$media_type" "$season" "$episode" "$imdb_id" "$title" "$year")

    local ct_file; ct_file=$(mktemp /tmp/krono_ct.XXXXXX)
    curl -s \
        -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:151.0) Gecko/20100101 Firefox/151.0" \
        -H "Origin: $CINEBY_REF" \
        -H "Referer: $CINEBY_REF" \
        "${VIDEASY_API}/${provider}/sources-with-title?${params}" \
        -o "$ct_file" 2>/dev/null || { rm -f "$ct_file"; return 1; }

    local result
    result=$(_decrypt_response "$ct_file" "$tmdb_id")
    rm -f "$ct_file"

    [[ $(printf '%s' "$result" | python3 -c "import json,sys; print(json.load(sys.stdin).get('success'))" 2>/dev/null) != "True" ]] && return 1

    local url
    url=$(printf '%s' "$result" | python3 "$SCRIPT_DIR/parse_stream.py")
    [[ -z "$url" ]] && return 1

    local sub_url
    sub_url=$(printf '%s' "$result" | python3 "$SCRIPT_DIR/parse_sub.py" 2>/dev/null)

    _verify_url "$url" || return 1

    printf '%s\n%s\n' "$url" "${sub_url:-}"
}

# ── sequential stream + subtitle fetch ───────────────────────────────────────
# outputs: "stream_url\nsub_url" from the first working provider
get_stream_and_sub() {
    local tmdb_id="$1" season="$2" episode="$3" media_type="$4" name="$5"
    local title year
    _parse_name "$name"
    local imdb_id
    imdb_id=$(get_imdb_id "$tmdb_id" "$media_type")
    local providers
    if [[ "$media_type" == "movie" ]]; then
        providers=(mb-flix cdn downloader2 superflix 1movies m4uhd lamovie e3b0c442)
    else
        providers=(cdn downloader2 mb-flix superflix 1movies m4uhd lamovie e3b0c442)
    fi
    for provider in "${providers[@]}"; do
        local probe
        probe=$(_probe_provider "$provider" "$tmdb_id" "$media_type" "$season" "$episode" "$imdb_id" "$title" "$year")
        if [[ -n "$probe" ]]; then
            [[ "${KRONO_DEBUG:-0}" == "1" ]] && info "[debug] provider: $provider"
            printf '%s\n' "$probe"
            return
        fi
    done
}

# ── interactive source picker ─────────────────────────────────────────────────
# outputs: "stream_url\nsub_url"
pick_source() {
    local tmdb_id="$1" media_type="$2" season="$3" episode="$4" name="$5"
    local title year
    _parse_name "$name"
    local imdb_id
    imdb_id=$(get_imdb_id "$tmdb_id" "$media_type")

    local tmp_dir; tmp_dir=$(mktemp -d /tmp/krono_pick.XXXXXX)
    local providers
    if [[ "$media_type" == "movie" ]]; then
        providers=(mb-flix cdn downloader2 superflix 1movies m4uhd lamovie e3b0c442)
    else
        providers=(cdn downloader2 mb-flix superflix 1movies m4uhd lamovie e3b0c442)
    fi

    info "Probing ${#providers[@]} sources in parallel..."

    for provider in "${providers[@]}"; do
        (
            local t0 t1
            t0=$(python3 -c "import time; print(int(time.time()*1000))")
            local probe
            probe=$(_probe_provider "$provider" "$tmdb_id" "$media_type" "$season" "$episode" "$imdb_id" "$title" "$year")
            t1=$(python3 -c "import time; print(int(time.time()*1000))")
            [[ -z "$probe" ]] && exit 0
            local stream_url sub_url
            stream_url=$(printf '%s\n' "$probe" | sed -n '1p')
            sub_url=$(printf '%s\n' "$probe" | sed -n '2p')
            local ms=$(( t1 - t0 ))
            local has_sub="✗"
            [[ -n "$sub_url" ]] && has_sub="✓"
            # format: display_text \t stream_url \t sub_url
            local speed
            if (( ms < 1000 )); then
                speed="${ms}ms"
            else
                speed=$(awk "BEGIN{printf \"%.1fs\", $ms/1000}")
            fi
            printf '%-14s  %6s  subs: %s\t%s\t%s\n' "$provider" "$speed" "$has_sub" "$stream_url" "$sub_url" \
                > "$tmp_dir/$(printf '%06d' "$ms")_${provider}"
        ) &
    done

    wait

    # collect sorted by speed (filenames start with ms_)
    local results
    results=$(cat "$tmp_dir"/* 2>/dev/null)
    rm -rf "$tmp_dir"

    [[ -z "$results" ]] && return 1

    local chosen
    chosen=$(printf '%s\n' "$results" | fzf --prompt="Pick source: " --height=12 --reverse \
        --delimiter=$'\t' --with-nth=1)
    [[ -z "$chosen" ]] && return 1

    local stream_url sub_url
    stream_url=$(printf '%s\n' "$chosen" | cut -f2)
    sub_url=$(printf '%s\n' "$chosen" | cut -f3)
    printf '%s\n%s\n' "$stream_url" "${sub_url:-}"
}

# ── anime (allanime) ──────────────────────────────────────────────────────────
anime_search() {
    local query="$1" trans_type="${2:-sub}"
    python3 "$SCRIPT_DIR/anime_search.py" "$query" "$trans_type" 2>/dev/null
}

# outputs: stream_url\treferer for the first provider that resolves + verifies
get_anime_stream_url() {
    local show_id="$1" episode="$2" trans_type="${3:-sub}"
    local sources
    sources=$(python3 "$SCRIPT_DIR/anime_sources.py" "$show_id" "$episode" "$trans_type" 2>/dev/null)
    [[ -z "$sources" ]] && return 1

    local priority name encoded_url
    while IFS=$'\t' read -r priority name encoded_url; do
        local extracted url referer
        extracted=$(python3 "$SCRIPT_DIR/anime_extract.py" "$encoded_url" "$name" 2>/dev/null)
        [[ -z "$extracted" ]] && continue
        url=$(printf '%s\n' "$extracted" | cut -f1)
        referer=$(printf '%s\n' "$extracted" | cut -f2)
        _verify_url "$url" "$referer" || continue
        printf '%s\t%s\n' "$url" "$referer"
        return 0
    done <<< "$sources"
    return 1
}

# ── interactive anime source picker (sub + dub, all providers) ────────────────
# outputs: stream_url\treferer
pick_anime_source() {
    local show_id="$1" show_name="$2" episode="$3"

    local tmp_dir; tmp_dir=$(mktemp -d /tmp/krono_pick.XXXXXX)
    info "Probing sub + dub sources in parallel..."

    for trans_type in sub dub; do
        (
            local sources
            sources=$(python3 "$SCRIPT_DIR/anime_sources.py" "$show_id" "$episode" "$trans_type" 2>/dev/null)
            [[ -z "$sources" ]] && exit 0
            local priority name encoded_url
            while IFS=$'\t' read -r priority name encoded_url; do
                (
                    local t0 t1
                    t0=$(python3 -c "import time; print(int(time.time()*1000))")
                    local extracted url referer
                    extracted=$(python3 "$SCRIPT_DIR/anime_extract.py" "$encoded_url" "$name" 2>/dev/null)
                    t1=$(python3 -c "import time; print(int(time.time()*1000))")
                    [[ -z "$extracted" ]] && exit 0
                    url=$(printf '%s\n' "$extracted" | cut -f1)
                    referer=$(printf '%s\n' "$extracted" | cut -f2)
                    _verify_url "$url" "$referer" || exit 0
                    local ms=$(( t1 - t0 ))
                    local speed
                    if (( ms < 1000 )); then speed="${ms}ms"
                    else speed=$(awk "BEGIN{printf \"%.1fs\", $ms/1000}")
                    fi
                    printf '%-12s %-5s %6s\t%s\t%s\n' "$name" "$trans_type" "$speed" "$url" "$referer" \
                        > "$tmp_dir/$(printf '%06d' "$ms")_${trans_type}_${name}"
                ) &
            done <<< "$sources"
            wait
        ) &
    done

    wait

    local results
    results=$(cat "$tmp_dir"/* 2>/dev/null)
    rm -rf "$tmp_dir"
    [[ -z "$results" ]] && return 1

    local chosen
    chosen=$(printf '%s\n' "$results" | fzf --prompt="Pick source: " --height=12 --reverse \
        --delimiter=$'\t' --with-nth=1)
    [[ -z "$chosen" ]] && return 1

    local url referer
    url=$(printf '%s\n' "$chosen" | cut -f2)
    referer=$(printf '%s\n' "$chosen" | cut -f3)
    printf '%s\t%s\n' "$url" "$referer"
}

# ── anime history helpers ──────────────────────────────────────────────────────
# format: show_id \t show_name \t episode \t position_seconds
anime_history_get() {
    grep -m1 "^${1}"$'\t' "$ANIME_HISTORY_FILE" | cut -f2-4
}
anime_history_set() {
    local key="$1" name="$2" ep="$3" pos="${4:-0}"
    local tmp; tmp=$(mktemp)
    grep -v "^${key}"$'\t' "$ANIME_HISTORY_FILE" > "$tmp"
