#!/usr/bin/env bash
# krono-cli — stream and track TV shows from the terminal
# github.com/waxburned/krono-cli

# ── config ──────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HISTORY_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/krono-cli/history.tsv"
TMDB_BASE="https://api.themoviedb.org/3"
VIDEASY_BASE="https://api.videasy.net/cdn/sources-with-title"
VIDKING_REF="https://www.vidking.net/"
PLAYER="${KRONO_PLAYER:-mpv}"
QUALITY="${KRONO_QUALITY:-1080p}"

mkdir -p "$(dirname "$HISTORY_FILE")"
[[ ! -f "$HISTORY_FILE" ]] && touch "$HISTORY_FILE"

# ── helpers ──────────────────────────────────────────────────────────────────
die()  { printf '\e[31mERROR\e[0m: %s\n' "$*" >&2; exit 1; }
info() { printf '\e[36m→\e[0m %s\n' "$*"; }
dep_check() {
    for d in fzf mpv node curl python3; do
        command -v "$d" &>/dev/null || die "Missing dependency: $d"
    done
}

# ── TMDB search ──────────────────────────────────────────────────────────────
tmdb_search() {
    local query="$1"
    local encoded_query
    encoded_query=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")
    curl -s \
        -A "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36" \
        "https://www.themoviedb.org/search/tv?query=${encoded_query}" \
    | python3 "$SCRIPT_DIR/tmdb_search.py"
}

# ── fetch & decrypt stream ────────────────────────────────────────────────────
get_stream_url() {
    local tmdb_id="$1" season="$2" episode="$3"
    local ct_file; ct_file=$(mktemp /tmp/krono_ct.XXXXXX)

    curl -s \
        -A "Mozilla/5.0" \
        -H "Origin: $VIDKING_REF" \
        -H "Referer: $VIDKING_REF" \
        "${VIDEASY_BASE}?tmdbId=${tmdb_id}&season=${season}&episode=${episode}&mediaType=tv" \
        -o "$ct_file" || { rm -f "$ct_file"; die "Failed to fetch stream data"; }

    local result
    result=$(node "$SCRIPT_DIR/decrypt.js" "$ct_file" "$tmdb_id" 2>/dev/null)
    rm -f "$ct_file"

    if [[ $(echo "$result" | python3 -c "import json,sys; print(json.load(sys.stdin).get('success'))") != "True" ]]; then
        die "Decryption failed"
    fi

    # Pick preferred quality, fallback to first available
    echo "$result" | python3 "$SCRIPT_DIR/parse_stream.py"
}

# ── subtitle helper ───────────────────────────────────────────────────────────
get_subtitle_url() {
    local tmdb_id="$1" season="$2" episode="$3"
    local ct_file; ct_file=$(mktemp /tmp/krono_ct.XXXXXX)
    curl -s -A "Mozilla/5.0" -H "Origin: $VIDKING_REF" -H "Referer: $VIDKING_REF" \
        "${VIDEASY_BASE}?tmdbId=${tmdb_id}&season=${season}&episode=${episode}&mediaType=tv" \
        -o "$ct_file" 2>/dev/null
    local result
    result=$(node "$SCRIPT_DIR/decrypt.js" "$ct_file" "$tmdb_id" 2>/dev/null)
    rm -f "$ct_file"
    echo "$result" | python3 "$SCRIPT_DIR/parse_sub.py" 2>/dev/null
}

# ── history helpers ───────────────────────────────────────────────────────────
history_get() {
    grep -m1 "^${1}"$'\t' "$HISTORY_FILE" | cut -f2,3
}
history_set() {
    local key="$1" season="$2" ep="$3"
    local tmp; tmp=$(mktemp)
    grep -v "^${key}"$'\t' "$HISTORY_FILE" > "$tmp"
    printf '%s\t%s\t%s\n' "$key" "$season" "$ep" >> "$tmp"
    mv "$tmp" "$HISTORY_FILE"
}
history_del() {
    local tmp; tmp=$(mktemp)
    grep -v "^${1}"$'\t' "$HISTORY_FILE" > "$tmp"
    mv "$tmp" "$HISTORY_FILE"
}

# ── play episode ──────────────────────────────────────────────────────────────
play_episode() {
    local tmdb_id="$1" show_name="$2" season="$3" ep="$4"

    info "Fetching stream for ${show_name} S${season}E${ep}..."
    local stream_url
    stream_url=$(get_stream_url "$tmdb_id" "$season" "$ep")
    [[ -z "$stream_url" ]] && die "No stream URL found"

    local sub_url
    sub_url=$(get_subtitle_url "$tmdb_id" "$season" "$ep")

    local sub_flag=()
    [[ -n "$sub_url" ]] && sub_flag=(--sub-file="$sub_url")

    info "Playing S${season}E${ep}..."
    "$PLAYER" \
        --force-media-title="${show_name} S${season}E${ep}" \
        --referrer="$VIDKING_REF" \
        "${sub_flag[@]}" \
        "$stream_url"

    local exit_code=$?

    if [[ $exit_code -eq 0 ]]; then
        local next_ep=$(( ep + 1 ))
        read -rp "Save progress? Advance to S${season}E${next_ep}? [Y/n/sXeY] " adv
        case "${adv,,}" in
            n) ;;
            s*e*)
                local new_s; new_s=$(echo "$adv" | grep -oi 's[0-9]*' | grep -oi '[0-9]*')
                local new_e; new_e=$(echo "$adv" | grep -oi 'e[0-9]*' | grep -oi '[0-9]*')
                history_set "$tmdb_id" "$new_s" "$new_e"
                info "Saved: S${new_s}E${new_e}"
                ;;
            *)
                history_set "$tmdb_id" "$season" "$next_ep"
                info "Saved: S${season}E${next_ep}"
                ;;
        esac
    fi
}

# ── season/episode picker ─────────────────────────────────────────────────────
pick_episode() {
    local tmdb_id="$1"

    # Fetch season list from TMDB
    local seasons
    seasons=$(curl -s -A "Mozilla/5.0" "https://www.themoviedb.org/tv/${tmdb_id}" \
        | python3 -c "
import sys, re
content = sys.stdin.read()
matches = re.findall(r'Season (\d+)', content)
seen = []
for m in matches:
    if m not in seen and m != '0':
        seen.append(m)
for s in seen:
    print(s)
" 2>/dev/null | head -20)

    [[ -z "$seasons" ]] && seasons=$(seq 1 5)

    local season
    season=$(echo "$seasons" | fzf --prompt="Season: " --height=10 --reverse < /dev/tty)
    [[ -z "$season" ]] && exit 0

    # Episodes 1-30 (we don't know max without TMDB API key)
    local episode
    episode=$(seq 1 30 | fzf --prompt="Episode: " --height=15 --reverse < /dev/tty)
    [[ -z "$episode" ]] && exit 0

    echo "$season $episode"
}

# ── commands ──────────────────────────────────────────────────────────────────
cmd_list() {
    if [[ ! -s "$HISTORY_FILE" ]]; then
        echo "No shows tracked yet."
        return
    fi
    echo "Tracked shows:"
    while IFS=$'\t' read -r tmdb_id season ep; do
        printf '  %-10s  S%sE%s\n' "($tmdb_id)" "$season" "$ep"
    done < "$HISTORY_FILE"
}

cmd_remove() {
    [[ -z "$1" ]] && die "Usage: krono-cli --remove <tmdb_id>"
    history_del "$1"
    info "Removed $1 from history"
}

cmd_search() {
    local query="$*"
    [[ -z "$query" ]] && read -rp "Search: " query
    [[ -z "$query" ]] && exit 0

    info "Searching for '${query}'..."
    local results
    results=$(tmdb_search "$query")
    [[ -z "$results" ]] && die "No results found"

    local chosen
    chosen=$(echo "$results" | fzf --prompt="Select show: " --height=20 --reverse --delimiter=$'\t' --with-nth=2)
    [[ -z "$chosen" ]] && exit 0

    local tmdb_id show_name
    tmdb_id=$(echo "$chosen" | cut -f1)
    show_name=$(echo "$chosen" | cut -f2)

    # Check history
    local saved
    saved=$(history_get "$tmdb_id")
    if [[ -n "$saved" ]]; then
        local saved_s saved_e
        saved_s=$(echo "$saved" | cut -f1)
        saved_e=$(echo "$saved" | cut -f2)
        read -rp "Continue '${show_name}' from S${saved_s}E${saved_e}? [Y/n] " cont
        if [[ "${cont,,}" != "n" ]]; then
            play_episode "$tmdb_id" "$show_name" "$saved_s" "$saved_e"
            return
        fi
    fi

    # Pick episode manually
    local picked
    picked=$(pick_episode "$tmdb_id")
    [[ -z "$picked" ]] && exit 0
    local s e
    s=$(echo "$picked" | cut -d' ' -f1)
    e=$(echo "$picked" | cut -d' ' -f2)

    play_episode "$tmdb_id" "$show_name" "$s" "$e"
}

# ── main ──────────────────────────────────────────────────────────────────────
dep_check

case "$1" in
    --list|-l)    cmd_list ;;
    --remove|-r)  cmd_remove "$2" ;;
    --help|-h)
        cat << 'EOF'
krono-cli — stream and track TV shows

Usage:
  krono-cli [show name]         Search and stream a show
  krono-cli --list              Show tracked progress
  krono-cli --remove <tmdb_id>  Remove a show from history

Environment:
  KRONO_PLAYER    Media player (default: mpv)
  KRONO_QUALITY   Preferred quality: 1080p, 720p, 480p, 4K (default: 1080p)
EOF
        ;;
    *)  cmd_search "$@" ;;
esac
