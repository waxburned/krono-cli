#!/usr/bin/env bash
# krono-cli — stream and track TV shows from the terminal
# github.com/waxburned/krono-cli

# ── config ──────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
HISTORY_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/krono-cli/history.tsv"
SESSION_CACHE="${XDG_STATE_HOME:-$HOME/.local/state}/krono-cli/session.json"
VIDEASY_API="https://api.videasy.to"
CINEBY_REF="https://www.cineby.at/"
PLAYER="${KRONO_PLAYER:-mpv}"
QUALITY="${KRONO_QUALITY:-1080p}"
PICK_SOURCE=0

mkdir -p "$(dirname "$HISTORY_FILE")"
[[ ! -f "$HISTORY_FILE" ]] && touch "$HISTORY_FILE"

# ── helpers ──────────────────────────────────────────────────────────────────
die()  { printf '\e[31mERROR\e[0m: %s\n' "$*" >&2; exit 1; }
info() { printf '\e[36m→\e[0m %s\n' "$*" >&2; }
dep_check() {
    for d in fzf mpv node curl python3; do
        command -v "$d" &>/dev/null || die "Missing dependency: $d"
    done
}

# ── TMDB search ──────────────────────────────────────────────────────────────
tmdb_search() {
    local query="$1"
    local encoded_query
    encoded_query=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")
    curl -s \
        -A "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36" \
        "https://www.themoviedb.org/search/tv?query=${encoded_query}" \
    | python3 "$SCRIPT_DIR/tmdb_search.py" tv
}

tmdb_movie_search() {
    local query="$1"
    local encoded_query
    encoded_query=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")
    curl -s \
        -A "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36" \
        "https://www.themoviedb.org/search/movie?query=${encoded_query}" \
    | python3 "$SCRIPT_DIR/tmdb_search.py" movie
}

# ── URL verification ──────────────────────────────────────────────────────────
_verify_url() {
    local url="$1"
    local verify_tmp; verify_tmp=$(mktemp /tmp/krono_verify.XXXXXX)
    local status
    status=$(curl -s --max-time 8 \
        -H "Referer: $CINEBY_REF" \
        -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:151.0) Gecko/20100101 Firefox/151.0" \
        -o "$verify_tmp" -w "%{http_code}" \
        "$url" 2>/dev/null)
    if ! [[ "$status" =~ ^(200|206|301|302)$ ]]; then
        rm -f "$verify_tmp"; return 1
    fi
    if [[ "$url" == *.m3u8* ]]; then
        local manifest; manifest=$(cat "$verify_tmp")
        if ! [[ "$manifest" == *"#EXTM3U"* ]]; then
            rm -f "$verify_tmp"; return 1
        fi
        local child; child=$(printf '%s\n' "$manifest" | grep -v '^#' | grep -v '^$' | head -1)
        if [[ -n "$child" ]]; then
            if [[ "$child" != http* ]]; then
                local base="${url%%\?*}"; base="${base%/*}"
                child="${base}/${child}"
            fi
            local child_status
            child_status=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
                -H "Referer: $CINEBY_REF" \
                -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:151.0) Gecko/20100101 Firefox/151.0" \
                "$child" 2>/dev/null)
            [[ "$child_status" =~ ^(200|206)$ ]] || { rm -f "$verify_tmp"; return 1; }
        fi
    fi
    rm -f "$verify_tmp"
}

# ── fetch & decrypt stream ────────────────────────────────────────────────────
_build_params() {
    local tmdb_id="$1" media_type="$2" season="$3" episode="$4" imdb_id="$5" title="$6" year="$7"
    local params="tmdbId=${tmdb_id}&mediaType=${media_type}"
    local sid="${season:-1}" eid="${episode:-1}"
    params+="&seasonId=${sid}&episodeId=${eid}"
    [[ -n "$imdb_id" ]] && params+="&imdbId=${imdb_id}"
    if [[ -n "$title" ]]; then
        local enc_title
        enc_title=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$title")
        params+="&title=${enc_title}"
    fi
    [[ -n "$year" ]] && params+="&year=${year}"
    echo "$params"
}

_decrypt_response() {
    local ct_file="$1" tmdb_id="$2"
    node "$SCRIPT_DIR/decrypt.js" "$ct_file" "$tmdb_id" 2>/dev/null
}

_fetch_stream() {
    local provider="$1" tmdb_id="$2" media_type="$3" season="$4" episode="$5" imdb_id="$6" title="$7" year="$8"
    local params
    params=$(_build_params "$tmdb_id" "$media_type" "$season" "$episode" "$imdb_id" "$title" "$year")

    local ct_file; ct_file=$(mktemp /tmp/krono_ct.XXXXXX)
    curl -s \
        -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:151.0) Gecko/20100101 Firefox/151.0" \
        -H "Origin: $CINEBY_REF" \
        -H "Referer: $CINEBY_REF" \
        "${VIDEASY_API}/${provider}/sources-with-title?${params}" \
        -o "$ct_file" 2>/dev/null || { rm -f "$ct_file"; return 1; }

    [[ "${KRONO_DEBUG:-0}" == "1" ]] && info "[debug] ${provider}: $(head -c 120 "$ct_file")" >&2

    local result
    result=$(_decrypt_response "$ct_file" "$tmdb_id")
    rm -f "$ct_file"

    [[ $(printf '%s' "$result" | python3 -c "import json,sys; print(json.load(sys.stdin).get('success'))" 2>/dev/null) != "True" ]] && return 1

    local url
    url=$(printf '%s' "$result" | python3 "$SCRIPT_DIR/parse_stream.py")
    [[ -z "$url" ]] && return 1

    _verify_url "$url" || return 1
    echo "$url"
}

get_imdb_id() {
    local tmdb_id="$1" media_type="${2:-tv}"
    curl -s -A "Mozilla/5.0" "https://www.themoviedb.org/${media_type}/${tmdb_id}" 2>/dev/null \
        | python3 -c "
import sys, re
m = re.search(r'href=\"https://www\.imdb\.com/title/(tt[0-9]+)', sys.stdin.read())
print(m.group(1) if m else '')
"
}

# Parse "Show Name (2026)" → sets $title and $year in caller scope
_parse_name() {
    local name="$1"
    year=""
    title="$name"
    if [[ "$name" =~ \(([0-9]{4})\)$ ]]; then
        year="${BASH_REMATCH[1]}"
        title="${name% \(${year}\)}"
    fi
}

get_stream_url() {
    local tmdb_id="$1" season="$2" episode="$3" show_name="$4"
    local title year
    _parse_name "$show_name"
    local imdb_id
    imdb_id=$(get_imdb_id "$tmdb_id" "tv")
    local url
    for provider in cdn downloader2 mb-flix superflix 1movies m4uhd lamovie e3b0c442; do
        url=$(_fetch_stream "$provider" "$tmdb_id" "tv" "$season" "$episode" "$imdb_id" "$title" "$year")
        if [[ -n "$url" ]]; then
            [[ "${KRONO_DEBUG:-0}" == "1" ]] && info "[debug] provider: $provider"
            echo "$url"; return
        fi
    done
}

get_movie_stream_url() {
    local tmdb_id="$1" movie_name="$2"
    local title year
    _parse_name "$movie_name"
    local imdb_id
    imdb_id=$(get_imdb_id "$tmdb_id" "movie")
    local url
    for provider in mb-flix cdn downloader2 superflix 1movies m4uhd lamovie e3b0c442; do
        url=$(_fetch_stream "$provider" "$tmdb_id" "movie" "" "" "$imdb_id" "$title" "$year")
        if [[ -n "$url" ]]; then
            [[ "${KRONO_DEBUG:-0}" == "1" ]] && info "[debug] provider: $provider"
            echo "$url"; return
        fi
    done
}

# ── subtitle helper ───────────────────────────────────────────────────────────
get_subtitle_url() {
    local tmdb_id="$1" season="$2" episode="$3" media_type="${4:-tv}"
    local params="tmdbId=${tmdb_id}&mediaType=${media_type}"
    [[ "$media_type" == "tv" ]] && params+="&seasonId=${season}&episodeId=${episode}"
    for provider in cdn mb-flix e3b0c442 downloader2 superflix; do
        local ct_file; ct_file=$(mktemp /tmp/krono_ct.XXXXXX)
        curl -s \
            -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:151.0) Gecko/20100101 Firefox/151.0" \
            -H "Origin: $CINEBY_REF" \
            -H "Referer: $CINEBY_REF" \
            "${VIDEASY_API}/${provider}/sources-with-title?${params}" \
            -o "$ct_file" 2>/dev/null
        local result
        result=$(_decrypt_response "$ct_file" "$tmdb_id")
        rm -f "$ct_file"
        local sub_url
        sub_url=$(printf '%s' "$result" | python3 "$SCRIPT_DIR/parse_sub.py" 2>/dev/null)
        [[ -n "$sub_url" ]] && echo "$sub_url" && return
    done
}

# ── probe provider (stream + subtitle in one API call) ────────────────────────
# outputs: "stream_url\nsub_url" or nothing if provider unavailable
_probe_provider() {
    local provider="$1" tmdb_id="$2" media_type="$3" season="$4" episode="$5" imdb_id="$6" title="$7" year="$8"
    local params
    params=$(_build_params "$tmdb_id" "$media_type" "$season" "$episode" "$imdb_id" "$title" "$year")

    local ct_file; ct_file=$(mktemp /tmp/krono_ct.XXXXXX)
    curl -s \
        -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:151.0) Gecko/20100101 Firefox/151.0" \
        -H "Origin: $CINEBY_REF" \
        -H "Referer: $CINEBY_REF" \
        "${VIDEASY_API}/${provider}/sources-with-title?${params}" \
        -o "$ct_file" 2>/dev/null || { rm -f "$ct_file"; return 1; }

    local result
    result=$(_decrypt_response "$ct_file" "$tmdb_id")
    rm -f "$ct_file"

    [[ $(printf '%s' "$result" | python3 -c "import json,sys; print(json.load(sys.stdin).get('success'))" 2>/dev/null) != "True" ]] && return 1

    local url
    url=$(printf '%s' "$result" | python3 "$SCRIPT_DIR/parse_stream.py")
    [[ -z "$url" ]] && return 1

    local sub_url
    sub_url=$(printf '%s' "$result" | python3 "$SCRIPT_DIR/parse_sub.py" 2>/dev/null)

    _verify_url "$url" || return 1

    printf '%s\n%s\n' "$url" "${sub_url:-}"
}

# ── interactive source picker ─────────────────────────────────────────────────
# outputs: "stream_url\nsub_url"
pick_source() {
    local tmdb_id="$1" media_type="$2" season="$3" episode="$4" name="$5"
    local title year
    _parse_name "$name"
    local imdb_id
    imdb_id=$(get_imdb_id "$tmdb_id" "$media_type")

    local tmp_dir; tmp_dir=$(mktemp -d /tmp/krono_pick.XXXXXX)
    local providers
    if [[ "$media_type" == "movie" ]]; then
        providers=(mb-flix cdn downloader2 superflix 1movies m4uhd lamovie e3b0c442)
    else
        providers=(cdn downloader2 mb-flix superflix 1movies m4uhd lamovie e3b0c442)
    fi

    info "Probing ${#providers[@]} sources in parallel..."

    for provider in "${providers[@]}"; do
        (
            local t0 t1
            t0=$(python3 -c "import time; print(int(time.time()*1000))")
            local probe
            probe=$(_probe_provider "$provider" "$tmdb_id" "$media_type" "$season" "$episode" "$imdb_id" "$title" "$year")
            t1=$(python3 -c "import time; print(int(time.time()*1000))")
            [[ -z "$probe" ]] && exit 0
            local stream_url sub_url
            stream_url=$(printf '%s\n' "$probe" | sed -n '1p')
            sub_url=$(printf '%s\n' "$probe" | sed -n '2p')
            local ms=$(( t1 - t0 ))
            local has_sub="✗"
            [[ -n "$sub_url" ]] && has_sub="✓"
            # format: display_text \t stream_url \t sub_url
            local speed
            if (( ms < 1000 )); then
                speed="${ms}ms"
            else
                speed=$(awk "BEGIN{printf \"%.1fs\", $ms/1000}")
            fi
            printf '%-14s  %6s  subs: %s\t%s\t%s\n' "$provider" "$speed" "$has_sub" "$stream_url" "$sub_url" \
                > "$tmp_dir/$(printf '%06d' "$ms")_${provider}"
        ) &
    done

    wait

    # collect sorted by speed (filenames start with ms_)
    local results
    results=$(cat "$tmp_dir"/* 2>/dev/null)
    rm -rf "$tmp_dir"

    [[ -z "$results" ]] && return 1

    local chosen
    chosen=$(printf '%s\n' "$results" | fzf --prompt="Pick source: " --height=12 --reverse \
        --delimiter=$'\t' --with-nth=1)
    [[ -z "$chosen" ]] && return 1

    local stream_url sub_url
    stream_url=$(printf '%s\n' "$chosen" | cut -f2)
    sub_url=$(printf '%s\n' "$chosen" | cut -f3)
    printf '%s\n%s\n' "$stream_url" "${sub_url:-}"
}

# ── history helpers ───────────────────────────────────────────────────────────
# format: tmdb_id \t show_name \t season \t episode \t position_seconds
history_get() {
    grep -m1 "^${1}"$'\t' "$HISTORY_FILE" | cut -f2-5
}
history_set() {
    local key="$1" name="$2" season="$3" ep="$4" pos="${5:-0}"
    local tmp; tmp=$(mktemp)
    grep -v "^${key}"$'\t' "$HISTORY_FILE" > "$tmp"
    printf '%s\t%s\t%s\t%s\t%s\n' "$key" "$name" "$season" "$ep" "$pos" >> "$tmp"
    mv "$tmp" "$HISTORY_FILE"
}
fmt_pos() {
    local s="$1"
    printf '%d:%02d:%02d' "$(( s/3600 ))" "$(( (s%3600)/60 ))" "$(( s%60 ))"
}
history_del() {
    local tmp; tmp=$(mktemp)
    grep -v "^${1}"$'\t' "$HISTORY_FILE" > "$tmp"
    mv "$tmp" "$HISTORY_FILE"
}

# ── play movie ───────────────────────────────────────────────────────────────
play_movie() {
    local tmdb_id="$1" movie_name="$2"
    local stream_url sub_url

    if [[ "$PICK_SOURCE" == "1" ]]; then
        local pick_result
        pick_result=$(pick_source "$tmdb_id" "movie" "" "" "$movie_name") || die "No working sources found"
        stream_url=$(printf '%s\n' "$pick_result" | sed -n '1p')
        sub_url=$(printf '%s\n' "$pick_result" | sed -n '2p')
    else
        info "Fetching stream for ${movie_name}..."
        stream_url=$(get_movie_stream_url "$tmdb_id" "$movie_name")
        [[ -z "$stream_url" ]] && die "No stream URL found — movie may not be available on any source"
        sub_url=$(get_subtitle_url "$tmdb_id" "" "" "movie")
    fi

    local sub_flag=()
    [[ -n "$sub_url" ]] && sub_flag=(--sub-file="$sub_url")

    info "Playing ${movie_name}..."
    "$PLAYER" \
        --force-media-title="${movie_name}" \
        --referrer="$CINEBY_REF" \
        --msg-level=ffmpeg/demuxer=no \
        --sub-visibility=yes \
        --cache=yes \
        --demuxer-max-bytes=20MiB \
        --demuxer-readahead-secs=15 \
        "${sub_flag[@]}" \
        "$stream_url"
}

# ── countdown to next episode ─────────────────────────────────────────────────
countdown_next() {
    local next="$1" seconds=5
    printf '\n'
    while [[ $seconds -gt 0 ]]; do
        printf '\r\e[36m→\e[0m Next episode \e[1m%s\e[0m in %ds... Press any key to cancel ' "$next" "$seconds"
        if read -r -s -n1 -t1 key; then
            printf '\r\e[KCancelled.                                    \n'
            return 1
        fi
        (( seconds-- ))
    done
    printf '\r\e[K'
    return 0
}

# ── play episode ──────────────────────────────────────────────────────────────
play_episode() {
    local tmdb_id="$1" show_name="$2" season="$3" ep="$4" start_pos="${5:-0}"

    while true; do
        local stream_url sub_url

        if [[ "$PICK_SOURCE" == "1" ]]; then
            local pick_result
            pick_result=$(pick_source "$tmdb_id" "tv" "$season" "$ep" "$show_name") || die "No working sources found"
            stream_url=$(printf '%s\n' "$pick_result" | sed -n '1p')
            sub_url=$(printf '%s\n' "$pick_result" | sed -n '2p')
        else
            info "Fetching stream for ${show_name} S${season}E${ep}..."
            stream_url=$(get_stream_url "$tmdb_id" "$season" "$ep" "$show_name")
            [[ -z "$stream_url" ]] && die "No stream URL found — episode may not be available on any source"
            sub_url=$(get_subtitle_url "$tmdb_id" "$season" "$ep")
        fi

        local sub_flag=() start_flag=()
        [[ -n "$sub_url" ]] && sub_flag=(--sub-file="$sub_url")
        [[ "$start_pos" -gt 0 ]] 2>/dev/null && start_flag=(--start="$start_pos")

        info "Playing S${season}E${ep}${start_pos:+$([ "$start_pos" -gt 0 ] 2>/dev/null && echo " (resuming from ${start_pos}s)")}..."
        local eof_file; eof_file=$(mktemp)
        rm -f "$eof_file"
        local eof_file_native; eof_file_native=$(cygpath -w "$eof_file" 2>/dev/null || echo "$eof_file")
        KRONO_EOF_FILE="$eof_file_native" "$PLAYER" \
            --force-media-title="${show_name} S${season}E${ep}" \
            --referrer="$CINEBY_REF" \
            --script="$SCRIPT_DIR/eof_detect.lua" \
            --msg-level=ffmpeg/demuxer=no \
            --sub-visibility=yes \
            "${start_flag[@]}" \
            "${sub_flag[@]}" \
            "$stream_url"

        local result; result=$(cat "$eof_file" 2>/dev/null); rm -f "$eof_file"
        local next_ep=$(( ep + 1 ))

        if [[ "$result" == "eof" ]]; then
            history_set "$tmdb_id" "$show_name" "$season" "$next_ep" 0
            countdown_next "S${season}E${next_ep}" || break
        else
            local pos="${result:-0}"
            history_set "$tmdb_id" "$show_name" "$season" "$ep" "$pos"
            info "See you next time! Progress saved at $(fmt_pos "$pos")."
            break
        fi

        ep=$next_ep
        start_pos=0
    done
}

# ── season/episode picker ─────────────────────────────────────────────────────
pick_episode() {
    local tmdb_id="$1" out_file="$2"

    local seasons
    seasons=$(curl -s -A "Mozilla/5.0" "https://www.themoviedb.org/tv/${tmdb_id}" \
        | python3 "$SCRIPT_DIR/tmdb_seasons.py" 2>/dev/null | head -20)
    [[ -z "$seasons" ]] && seasons=$(seq 1 5)

    local season
    season=$(echo "$seasons" | fzf --prompt="Season: " --height=10 --reverse)
    [[ -z "$season" ]] && return 1

    local episode
    episode=$(seq 1 30 | fzf --prompt="Episode: " --height=15 --reverse)
    [[ -z "$episode" ]] && return 1

    echo "$season $episode" > "$out_file"
}

# ── commands ──────────────────────────────────────────────────────────────────
cmd_list() {
    if [[ ! -s "$HISTORY_FILE" ]]; then
        echo "No shows tracked yet."
        return
    fi
    echo "Tracked shows:"
    while IFS=$'\t' read -r tmdb_id show_name season ep pos; do
        local label="S${season}E${ep}"
        [[ "${pos:-0}" -gt 0 ]] 2>/dev/null && label+=" ($(fmt_pos "$pos"))"
        printf '  %-30s  %-20s  (id: %s)\n' "$show_name" "$label" "$tmdb_id"
    done < "$HISTORY_FILE"
}

cmd_remove() {
    [[ -z "$1" ]] && die "Usage: krono-cli --remove <tmdb_id>"
    history_del "$1"
    info "Removed $1 from history"
}

cmd_set_session() {
    local token="$1"
    [[ -z "$token" ]] && die "Usage: krono-cli --set-session <token>"
    mkdir -p "$(dirname "$SESSION_CACHE")"
    python3 -c "
import json, time, sys
data = {'token': sys.argv[1], 'expiresAt': int((time.time() + 1500) * 1000)}
with open(sys.argv[2], 'w') as f:
    json.dump(data, f)
" "$token" "$SESSION_CACHE"
    info "Session token saved (valid for ~25 minutes)"
    info "To refresh: open Cineby → F12 → Network → filter 'auth/session' → copy 'token' value"
}

cmd_movie() {
    local query="$*"
    [[ -z "$query" ]] && read -rp "Search movie: " query
    [[ -z "$query" ]] && exit 0

    info "Searching for '${query}'..."
    local results
    results=$(tmdb_movie_search "$query")
    [[ -z "$results" ]] && die "No results found"

    local chosen
    chosen=$(echo "$results" | fzf --prompt="Select movie: " --height=20 --reverse --delimiter=$'\t' --with-nth=2)
    [[ -z "$chosen" ]] && exit 0

    local tmdb_id movie_name
    tmdb_id=$(echo "$chosen" | cut -f1)
    movie_name=$(echo "$chosen" | cut -f2)

    play_movie "$tmdb_id" "$movie_name"
}

cmd_search() {
    local query="$*"
    [[ -z "$query" ]] && read -rp "Search: " query
    [[ -z "$query" ]] && exit 0

    info "Searching for '${query}'..."
    local results
    results=$(tmdb_search "$query")
    [[ -z "$results" ]] && die "No results found"

    local chosen
    chosen=$(echo "$results" | fzf --prompt="Select show: " --height=20 --reverse --delimiter=$'\t' --with-nth=2)
    [[ -z "$chosen" ]] && exit 0

    local tmdb_id show_name
    tmdb_id=$(echo "$chosen" | cut -f1)
    show_name=$(echo "$chosen" | cut -f2)

    local saved
    saved=$(history_get "$tmdb_id")
    if [[ -n "$saved" ]]; then
        local saved_s saved_e saved_pos
        saved_s=$(echo "$saved" | cut -f2)
        saved_e=$(echo "$saved" | cut -f3)
        saved_pos=$(echo "$saved" | cut -f4)
        local resume_msg="S${saved_s}E${saved_e}"
        [[ "${saved_pos:-0}" -gt 0 ]] 2>/dev/null && resume_msg+=" at $(fmt_pos "$saved_pos")"
        read -rp "Continue '${show_name}' from ${resume_msg}? [Y/n] " cont
        if [[ "${cont,,}" != "n" ]]; then
            play_episode "$tmdb_id" "$show_name" "$saved_s" "$saved_e" "$saved_pos"
            return
        fi
    fi

    local pick_file; pick_file=$(mktemp)
    pick_episode "$tmdb_id" "$pick_file" || { rm -f "$pick_file"; exit 0; }
    local picked; picked=$(cat "$pick_file"); rm -f "$pick_file"
    [[ -z "$picked" ]] && exit 0
    local s e
    s=$(echo "$picked" | cut -d' ' -f1)
    e=$(echo "$picked" | cut -d' ' -f2)

    play_episode "$tmdb_id" "$show_name" "$s" "$e"
}

# ── main ──────────────────────────────────────────────────────────────────────
dep_check

# strip -p/--pick from args before dispatch
CLEAN_ARGS=()
for _arg in "$@"; do
    case "$_arg" in
        --pick|-p) PICK_SOURCE=1 ;;
        *) CLEAN_ARGS+=("$_arg") ;;
    esac
done
set -- "${CLEAN_ARGS[@]}"

case "$1" in
    --list|-l)         cmd_list ;;
    --remove|-r)       cmd_remove "$2" ;;
    --movie|-m)        cmd_movie "${@:2}" ;;
    --set-session)     cmd_set_session "$2" ;;
    --help|-h)
        cat << 'EOF'
krono-cli — stream and track TV shows and movies

Usage:
  krono-cli [show name]              Search and stream a TV show
  krono-cli --movie [title]          Search and stream a movie
