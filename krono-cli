# ── history helpers ───────────────────────────────────────────────────────────
# format: tmdb_id \t show_name \t season \t episode \t position_seconds
history_get() {
    grep -m1 "^${1}"$'\t' "$HISTORY_FILE" | cut -f2-5
}
history_set() {
    local key="$1" name="$2" season="$3" ep="$4" pos="${5:-0}"
    local tmp; tmp=$(mktemp "$(dirname "$HISTORY_FILE")/history.XXXXXX")
    grep -v "^${key}"$'\t' "$HISTORY_FILE" > "$tmp"
    printf '%s\t%s\t%s\t%s\t%s\n' "$key" "$name" "$season" "$ep" "$pos" >> "$tmp"
    mv "$tmp" "$HISTORY_FILE"
}
fmt_pos() {
    local s="$1"
    printf '%d:%02d:%02d' "$(( s/3600 ))" "$(( (s%3600)/60 ))" "$(( s%60 ))"
}
history_del() {
    local tmp; tmp=$(mktemp "$(dirname "$HISTORY_FILE")/history.XXXXXX")
    grep -v "^${1}"$'\t' "$HISTORY_FILE" > "$tmp"
    mv "$tmp" "$HISTORY_FILE"
}

# ── play movie ───────────────────────────────────────────────────────────────
play_movie() {
    local tmdb_id="$1" movie_name="$2"
    local stream_url sub_url

    if [[ "$PICK_SOURCE" == "1" ]]; then
        local pick_result
        pick_result=$(pick_source "$tmdb_id" "movie" "" "" "$movie_name") || die "No working sources found"
        stream_url=$(printf '%s\n' "$pick_result" | sed -n '1p')
        sub_url=$(printf '%s\n' "$pick_result" | sed -n '2p')
    else
        info "Fetching stream for ${movie_name}..."
        local fetch_result
        fetch_result=$(get_stream_and_sub "$tmdb_id" "" "" "movie" "$movie_name")
        [[ -z "$fetch_result" ]] && die "No stream URL found — movie may not be available on any source"
        stream_url=$(printf '%s\n' "$fetch_result" | sed -n '1p')
        sub_url=$(printf '%s\n' "$fetch_result" | sed -n '2p')
    fi

    local sub_flag=()
    [[ -n "$sub_url" ]] && sub_flag=(--sub-file="$sub_url")

    info "Playing ${movie_name}..."
    "$PLAYER" \
        --force-media-title="${movie_name}" \
        --referrer="$CINEBY_REF" \
        --msg-level=ffmpeg/demuxer=no \
        --sub-visibility=yes \
        --cache=yes \
        --demuxer-max-bytes=20MiB \
        --demuxer-readahead-secs=15 \
        "${sub_flag[@]}" \
        "$stream_url"
}

# ── countdown to next episode ─────────────────────────────────────────────────
countdown_next() {
    local next="$1" seconds=5
    printf '\n'
    while [[ $seconds -gt 0 ]]; do
        printf '\r\e[36m→\e[0m Next episode \e[1m%s\e[0m in %ds... Press any key to cancel ' "$next" "$seconds"
        if read -r -s -n1 -t1 key; then
            printf '\r\e[KCancelled.                                    \n'
            return 1
        fi
        (( seconds-- ))
    done
    printf '\r\e[K'
    return 0
}

# ── play episode ──────────────────────────────────────────────────────────────
play_episode() {
    local tmdb_id="$1" show_name="$2" season="$3" ep="$4" start_pos="${5:-0}"

    while true; do
        local stream_url sub_url

        if [[ "$PICK_SOURCE" == "1" ]]; then
            local pick_result
            pick_result=$(pick_source "$tmdb_id" "tv" "$season" "$ep" "$show_name") || die "No working sources found"
            stream_url=$(printf '%s\n' "$pick_result" | sed -n '1p')
            sub_url=$(printf '%s\n' "$pick_result" | sed -n '2p')
        else
            info "Fetching stream for ${show_name} S${season}E${ep}..."
            local fetch_result
            fetch_result=$(get_stream_and_sub "$tmdb_id" "$season" "$ep" "tv" "$show_name")
            [[ -z "$fetch_result" ]] && die "No stream URL found — episode may not be available on any source"
            stream_url=$(printf '%s\n' "$fetch_result" | sed -n '1p')
            sub_url=$(printf '%s\n' "$fetch_result" | sed -n '2p')
        fi

        local sub_flag=() start_flag=()
        [[ -n "$sub_url" ]] && sub_flag=(--sub-file="$sub_url")
        [[ "$start_pos" -gt 0 ]] 2>/dev/null && start_flag=(--start="$start_pos")

        info "Playing S${season}E${ep}${start_pos:+$([ "$start_pos" -gt 0 ] 2>/dev/null && echo " (resuming from ${start_pos}s)")}..."
        local eof_file; eof_file=$(mktemp)
        rm -f "$eof_file"
        local eof_file_native; eof_file_native=$(cygpath -w "$eof_file" 2>/dev/null || echo "$eof_file")
        KRONO_EOF_FILE="$eof_file_native" "$PLAYER" \
            --force-media-title="${show_name} S${season}E${ep}" \
            --referrer="$CINEBY_REF" \
            --script="$SCRIPT_DIR/eof_detect.lua" \
            --msg-level=ffmpeg/demuxer=no \
            --sub-visibility=yes \
            --cache=yes \
            --demuxer-max-bytes=20MiB \
            --demuxer-readahead-secs=15 \
            "${start_flag[@]}" \
            "${sub_flag[@]}" \
            "$stream_url"

        local result; result=$(cat "$eof_file" 2>/dev/null); rm -f "$eof_file"
        local next_ep=$(( ep + 1 ))

        if [[ "$result" == "eof" ]]; then
            history_set "$tmdb_id" "$show_name" "$season" "$next_ep" 0
            countdown_next "S${season}E${next_ep}" || break
        else
            local pos="${result:-0}"
            history_set "$tmdb_id" "$show_name" "$season" "$ep" "$pos"
            info "See you next time! Progress saved at $(fmt_pos "$pos")."
            break
        fi

        ep=$next_ep
        start_pos=0
    done
}

# ── play anime episode ────────────────────────────────────────────────────────
play_anime_episode() {
    local show_id="$1" show_name="$2" episode="$3" mal_id="$4" trans_type="${5:-sub}" start_pos="${6:-0}"

    while true; do
        local stream_url referer

        if [[ "$PICK_SOURCE" == "1" ]]; then
            local pick_result
            pick_result=$(pick_anime_source "$show_id" "$show_name" "$episode") || die "No working sources found"
            stream_url=$(printf '%s\n' "$pick_result" | cut -f1)
            referer=$(printf '%s\n' "$pick_result" | cut -f2)
        else
            info "Fetching stream for ${show_name} Episode ${episode} [${trans_type}]..."
            local result
            result=$(get_anime_stream_url "$show_id" "$episode" "$trans_type")
            [[ -z "$result" ]] && die "No stream found — episode may not be available on any source"
            stream_url=$(printf '%s\n' "$result" | cut -f1)
            referer=$(printf '%s\n' "$result" | cut -f2)
        fi

        local start_flag=()
        [[ "$start_pos" -gt 0 ]] 2>/dev/null && start_flag=(--start="$start_pos")

        info "Playing ${show_name} Episode ${episode}${start_pos:+$([ "$start_pos" -gt 0 ] 2>/dev/null && echo " (resuming from ${start_pos}s)")}..."
        local eof_file; eof_file=$(mktemp)
        rm -f "$eof_file"
        local eof_file_native; eof_file_native=$(cygpath -w "$eof_file" 2>/dev/null || echo "$eof_file")
        KRONO_EOF_FILE="$eof_file_native" "$PLAYER" \
            --force-media-title="${show_name} Episode ${episode} [${trans_type^^}]" \
            --referrer="${referer:-$ALLANIME_REF}" \
            --script="$SCRIPT_DIR/eof_detect.lua" \
            --msg-level=ffmpeg/demuxer=no \
            "${start_flag[@]}" \
            "$stream_url"

        local result; result=$(cat "$eof_file" 2>/dev/null); rm -f "$eof_file"
        local next_ep=$(( episode + 1 ))

        if [[ "$result" == "eof" ]]; then
            anime_history_set "$show_id" "$show_name" "$next_ep" 0
            mal_update_episode "$mal_id" "$episode"
            anilist_update_episode "$mal_id" "$show_name" "$episode"
            countdown_next "Episode ${next_ep}" || break
        else
            local pos="${result:-0}"
            anime_history_set "$show_id" "$show_name" "$episode" "$pos"
            info "See you next time! Progress saved at $(fmt_pos "$pos")."
            break
        fi

        episode=$next_ep
        start_pos=0
    done
}

# ── season/episode picker ─────────────────────────────────────────────────────
pick_episode() {
    local tmdb_id="$1" out_file="$2"

    local seasons
    seasons=$(curl -s -A "Mozilla/5.0" "https://www.themoviedb.org/tv/${tmdb_id}" \
        | python3 "$SCRIPT_DIR/tmdb_seasons.py" 2>/dev/null | head -20)
    [[ -z "$seasons" ]] && seasons=$(seq 1 5)

    local season
    season=$(echo "$seasons" | fzf --prompt="Season: " --height=10 --reverse)
    [[ -z "$season" ]] && return 1

    local episode
    episode=$(seq 1 30 | fzf --prompt="Episode: " --height=15 --reverse)
    [[ -z "$episode" ]] && return 1

    echo "$season $episode" > "$out_file"
}

# ── commands ──────────────────────────────────────────────────────────────────
cmd_list() {
    if [[ ! -s "$HISTORY_FILE" ]]; then
        echo "No shows tracked yet."
        return
    fi
    echo "Tracked shows:"
    while IFS=$'\t' read -r tmdb_id show_name season ep pos; do
        local label="S${season}E${ep}"
        [[ "${pos:-0}" -gt 0 ]] 2>/dev/null && label+=" ($(fmt_pos "$pos"))"
        printf '  %-30s  %-20s  (id: %s)\n' "$show_name" "$label" "$tmdb_id"
    done < "$HISTORY_FILE"
}

cmd_remove() {
    [[ -z "$1" ]] && die "Usage: krono-cli --remove <tmdb_id>"
    history_del "$1"
    info "Removed $1 from history"
}

cmd_movie() {
    local query="$*"
    [[ -z "$query" ]] && read -rp "Search movie: " query
    [[ -z "$query" ]] && exit 0

    info "Searching for '${query}'..."
    local results
    results=$(tmdb_movie_search "$query")
    [[ -z "$results" ]] && die "No results found"

    local chosen
    chosen=$(echo "$results" | fzf --prompt="Select movie: " --height=20 --reverse --delimiter=$'\t' --with-nth=2)
    [[ -z "$chosen" ]] && exit 0

    local tmdb_id movie_name
    tmdb_id=$(echo "$chosen" | cut -f1)
    movie_name=$(echo "$chosen" | cut -f2)

    play_movie "$tmdb_id" "$movie_name"
}

cmd_anime() {
    local query="$*"
    [[ -z "$query" ]] && read -rp "Search anime: " query
    [[ -z "$query" ]] && exit 0

    local trans_type="sub"
    [[ "$DUB_MODE" == "1" ]] && trans_type="dub"

    info "Searching for '${query}' [${trans_type}]..."
    local results
    results=$(anime_search "$query" "$trans_type")
    [[ -z "$results" ]] && die "No results found"

    local chosen
    chosen=$(printf '%s\n' "$results" | fzf --prompt="Select anime: " --height=20 --reverse \
        --delimiter=$'\t' --with-nth=2)
    [[ -z "$chosen" ]] && exit 0

    local show_id show_name ep_count mal_id
    show_id=$(printf '%s\n' "$chosen" | cut -f1)
    show_name=$(printf '%s\n' "$chosen" | cut -f2)
    ep_count=$(printf '%s\n' "$chosen" | cut -f3)
    mal_id=$(printf '%s\n' "$chosen" | cut -f4)

    local saved
    saved=$(anime_history_get "$show_id")
    if [[ -n "$saved" ]]; then
        local saved_name saved_ep saved_pos
        saved_name=$(printf '%s\n' "$saved" | cut -f1)
        saved_ep=$(printf '%s\n' "$saved" | cut -f2)
        saved_pos=$(printf '%s\n' "$saved" | cut -f3)
        local resume_msg="Episode ${saved_ep}"
        [[ "${saved_pos:-0}" -gt 0 ]] 2>/dev/null && resume_msg+=" at $(fmt_pos "$saved_pos")"
        read -rp "Continue '${show_name}' from ${resume_msg}? [Y/n] " cont
        if [[ "${cont,,}" != "n" ]]; then
            play_anime_episode "$show_id" "$show_name" "$saved_ep" "$mal_id" "$trans_type" "$saved_pos"
            return
        fi
    fi

    local max_ep="${ep_count:-0}"
    [[ "$max_ep" -le 0 ]] 2>/dev/null && max_ep=100
    local episode
    episode=$(seq 1 "$max_ep" | fzf --prompt="Episode: " --height=15 --reverse)
    [[ -z "$episode" ]] && exit 0

    play_anime_episode "$show_id" "$show_name" "$episode" "$mal_id" "$trans_type" 0
}

cmd_mal_auth() {
    local client_id="${MAL_CLIENT_ID:-}"
    [[ -z "$client_id" ]] && die "Set the MAL_CLIENT_ID environment variable first — register an app at myanimelist.net/apiconfig"
    python3 "$SCRIPT_DIR/mal_auth.py" "$client_id" "$MAL_TOKEN_FILE"
}

cmd_anilist_auth() {
    python3 "$SCRIPT_DIR/anilist_auth.py" "$ANILIST_TOKEN_FILE"
}

cmd_search() {
    local query="$*"
    [[ -z "$query" ]] && read -rp "Search: " query
    [[ -z "$query" ]] && exit 0

    info "Searching for '${query}'..."
    local results
    results=$(tmdb_search "$query")
    [[ -z "$results" ]] && die "No results found"

    local chosen
    chosen=$(echo "$results" | fzf --prompt="Select show: " --height=20 --reverse --delimiter=$'\t' --with-nth=2)
    [[ -z "$chosen" ]] && exit 0

    local tmdb_id show_name
    tmdb_id=$(echo "$chosen" | cut -f1)
    show_name=$(echo "$chosen" | cut -f2)

    local saved
    saved=$(history_get "$tmdb_id")
    if [[ -n "$saved" ]]; then
        local saved_s saved_e saved_pos
        saved_s=$(echo "$saved" | cut -f2)
        saved_e=$(echo "$saved" | cut -f3)
        saved_pos=$(echo "$saved" | cut -f4)
        local resume_msg="S${saved_s}E${saved_e}"
        [[ "${saved_pos:-0}" -gt 0 ]] 2>/dev/null && resume_msg+=" at $(fmt_pos "$saved_pos")"
        read -rp "Continue '${show_name}' from ${resume_msg}? [Y/n] " cont
        if [[ "${cont,,}" != "n" ]]; then
            play_episode "$tmdb_id" "$show_name" "$saved_s" "$saved_e" "$saved_pos"
            return
        fi
    fi

    local pick_file; pick_file=$(mktemp)
    pick_episode "$tmdb_id" "$pick_file" || { rm -f "$pick_file"; exit 0; }
    local picked; picked=$(cat "$pick_file"); rm -f "$pick_file"
    [[ -z "$picked" ]] && exit 0
    local s e
    s=$(echo "$picked" | cut -d' ' -f1)
    e=$(echo "$picked" | cut -d' ' -f2)

    play_episode "$tmdb_id" "$show_name" "$s" "$e"
}

# ── main ──────────────────────────────────────────────────────────────────────
dep_check

# strip -p/--pick from args before dispatch
CLEAN_ARGS=()
for _arg in "$@"; do
    case "$_arg" in
        --pick|-p) PICK_SOURCE=1 ;;
        --dub)     DUB_MODE=1 ;;
        *) CLEAN_ARGS+=("$_arg") ;;
    esac
done
set -- "${CLEAN_ARGS[@]}"

case "$1" in
    --list|-l)         cmd_list ;;
    --remove|-r)       cmd_remove "$2" ;;
    --movie|-m)        cmd_movie "${@:2}" ;;
    --anime|-a)        cmd_anime "${@:2}" ;;
    --mal-auth)        cmd_mal_auth ;;
    --anilist-auth)    cmd_anilist_auth ;;
    --help|-h)
        cat << 'EOF'
krono-cli — stream and track TV shows, movies, and anime

Usage:
  krono-cli [show name]              Search and stream a TV show
  krono-cli --movie [title]          Search and stream a movie
  krono-cli --anime [title]          Search and stream an anime (sub by default)
  krono-cli --anime --dub [title]    Search and stream an anime, dubbed
  krono-cli -p [show name]           Pick source for a TV show
  krono-cli --movie -p [title]       Pick source for a movie
  krono-cli --anime -p [title]       Pick source for an anime (shows sub + dub)
  krono-cli --list                   Show tracked progress
  krono-cli --remove <tmdb_id>       Remove a show from history
  krono-cli --mal-auth               Authenticate with MyAnimeList
  krono-cli --anilist-auth           Authenticate with AniList

MyAnimeList tracking:
  Register an app at myanimelist.net/apiconfig, then:
    MAL_CLIENT_ID=<id> krono-cli --mal-auth
  Watched anime episodes auto-update your MAL list after this.

AniList tracking:
  krono-cli --anilist-auth
