#!/usr/bin/env bash
# krono-cli — stream and track TV shows from the terminal
# github.com/waxburned/krono-cli

# ── config ──────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HISTORY_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/krono-cli/history.tsv"
TMDB_BASE="https://api.themoviedb.org/3"
VIDEASY_BASE="https://api.videasy.net/cdn/sources-with-title"
VIDKING_REF="https://www.vidking.net/"
PLAYER="${KRONO_PLAYER:-mpv}"
QUALITY="${KRONO_QUALITY:-1080p}"

mkdir -p "$(dirname "$HISTORY_FILE")"
[[ ! -f "$HISTORY_FILE" ]] && touch "$HISTORY_FILE"

# ── helpers ──────────────────────────────────────────────────────────────────
die()  { printf '\e[31mERROR\e[0m: %s\n' "$*" >&2; exit 1; }
info() { printf '\e[36m→\e[0m %s\n' "$*"; }
dep_check() {
    for d in fzf mpv node curl python3; do
        command -v "$d" &>/dev/null || die "Missing dependency: $d"
    done
}

# ── TMDB search ──────────────────────────────────────────────────────────────
tmdb_search() {
    local query="$1"
    local encoded_query
    encoded_query=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")
    curl -s \
        -A "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36" \
        "https://www.themoviedb.org/search/tv?query=${encoded_query}" \
    | python3 "$SCRIPT_DIR/tmdb_search.py"
}

# ── fetch & decrypt stream ────────────────────────────────────────────────────
get_stream_url() {
    local tmdb_id="$1" season="$2" episode="$3"
    local ct_file; ct_file=$(mktemp /tmp/krono_ct.XXXXXX)

    curl -s \
        -A "Mozilla/5.0" \
        -H "Origin: $VIDKING_REF" \
        -H "Referer: $VIDKING_REF" \
        "${VIDEASY_BASE}?tmdbId=${tmdb_id}&seasonId=${season}&episodeId=${episode}&mediaType=tv" \
        -o "$ct_file" || { rm -f "$ct_file"; die "Failed to fetch stream data"; }

    local result
    result=$(node "$SCRIPT_DIR/decrypt.js" "$ct_file" "$tmdb_id" 2>/dev/null)
    rm -f "$ct_file"

    if [[ $(echo "$result" | python3 -c "import json,sys; print(json.load(sys.stdin).get('success'))") != "True" ]]; then
        die "Decryption failed"
    fi

    # Pick preferred quality, fallback to first available
    echo "$result" | python3 "$SCRIPT_DIR/parse_stream.py"
}

# ── subtitle helper ───────────────────────────────────────────────────────────
get_subtitle_url() {
    local tmdb_id="$1" season="$2" episode="$3"
    local ct_file; ct_file=$(mktemp /tmp/krono_ct.XXXXXX)
    curl -s -A "Mozilla/5.0" -H "Origin: $VIDKING_REF" -H "Referer: $VIDKING_REF" \
        "${VIDEASY_BASE}?tmdbId=${tmdb_id}&seasonId=${season}&episodeId=${episode}&mediaType=tv" \
        -o "$ct_file" 2>/dev/null
    local result
    result=$(node "$SCRIPT_DIR/decrypt.js" "$ct_file" "$tmdb_id" 2>/dev/null)
    rm -f "$ct_file"
    echo "$result" | python3 "$SCRIPT_DIR/parse_sub.py" 2>/dev/null
}

# ── history helpers ───────────────────────────────────────────────────────────
# format: tmdb_id \t show_name \t season \t episode \t position_seconds
history_get() {
    grep -m1 "^${1}"$'\t' "$HISTORY_FILE" | cut -f2-5
}
history_set() {
    local key="$1" name="$2" season="$3" ep="$4" pos="${5:-0}"
    local tmp; tmp=$(mktemp)
    grep -v "^${key}"$'\t' "$HISTORY_FILE" > "$tmp"
    printf '%s\t%s\t%s\t%s\t%s\n' "$key" "$name" "$season" "$ep" "$pos" >> "$tmp"
    mv "$tmp" "$HISTORY_FILE"
}
fmt_pos() {
    local s="$1"
    printf '%d:%02d:%02d' "$(( s/3600 ))" "$(( (s%3600)/60 ))" "$(( s%60 ))"
}
history_del() {
    local tmp; tmp=$(mktemp)
    grep -v "^${1}"$'\t' "$HISTORY_FILE" > "$tmp"
    mv "$tmp" "$HISTORY_FILE"
}

# ── countdown to next episode ─────────────────────────────────────────────────
countdown_next() {
    local next="$1" seconds=5
    printf '\n'
    while [[ $seconds -gt 0 ]]; do
        printf '\r\e[36m→\e[0m Next episode \e[1m%s\e[0m in %ds... Press any key to cancel ' "$next" "$seconds"
        if read -r -s -n1 -t1 key; then
            printf '\r\e[KCancelled.                                    \n'
            return 1
        fi
        (( seconds-- ))
    done
    printf '\r\e[K'
    return 0
}

# ── play episode ──────────────────────────────────────────────────────────────
play_episode() {
    local tmdb_id="$1" show_name="$2" season="$3" ep="$4" start_pos="${5:-0}"

    while true; do
        info "Fetching stream for ${show_name} S${season}E${ep}..."
        local stream_url
        stream_url=$(get_stream_url "$tmdb_id" "$season" "$ep")
        [[ -z "$stream_url" ]] && die "No stream URL found"

        local sub_url
        sub_url=$(get_subtitle_url "$tmdb_id" "$season" "$ep")

        local sub_flag=() start_flag=()
        [[ -n "$sub_url" ]] && sub_flag=(--sub-file="$sub_url")
        [[ "$start_pos" -gt 0 ]] 2>/dev/null && start_flag=(--start="$start_pos")

        info "Playing S${season}E${ep}${start_pos:+$([ "$start_pos" -gt 0 ] 2>/dev/null && echo " (resuming from ${start_pos}s)")}..."
        local eof_file; eof_file=$(mktemp)
        rm -f "$eof_file"
        KRONO_EOF_FILE="$eof_file" "$PLAYER" \
            --force-media-title="${show_name} S${season}E${ep}" \
            --referrer="$VIDKING_REF" \
            --script="$SCRIPT_DIR/eof_detect.lua" \
            "${start_flag[@]}" \
            "${sub_flag[@]}" \
            "$stream_url"

        local result; result=$(cat "$eof_file" 2>/dev/null); rm -f "$eof_file"
        local next_ep=$(( ep + 1 ))

        if [[ "$result" == "eof" ]]; then
            # Episode finished naturally — save next ep at pos 0 and countdown
            history_set "$tmdb_id" "$show_name" "$season" "$next_ep" 0
            countdown_next "S${season}E${next_ep}" || break
        else
            # User quit early — save current position and say goodbye
            local pos="${result:-0}"
            history_set "$tmdb_id" "$show_name" "$season" "$ep" "$pos"
            info "See you next time! Progress saved at $(fmt_pos "$pos")."
            break
        fi

        ep=$next_ep
        start_pos=0
    done
}

# ── season/episode picker ─────────────────────────────────────────────────────
pick_episode() {
    local tmdb_id="$1" out_file="$2"

    # Fetch season list from TMDB
    local seasons
    seasons=$(curl -s -A "Mozilla/5.0" "https://www.themoviedb.org/tv/${tmdb_id}" \
        | python3 "$SCRIPT_DIR/tmdb_seasons.py" 2>/dev/null | head -20)
    [[ -z "$seasons" ]] && seasons=$(seq 1 5)

    local season
    season=$(echo "$seasons" | fzf --prompt="Season: " --height=10 --reverse)
    [[ -z "$season" ]] && return 1

    local episode
    episode=$(seq 1 30 | fzf --prompt="Episode: " --height=15 --reverse)
    [[ -z "$episode" ]] && return 1

    echo "$season $episode" > "$out_file"
}

# ── commands ──────────────────────────────────────────────────────────────────
cmd_list() {
    if [[ ! -s "$HISTORY_FILE" ]]; then
        echo "No shows tracked yet."
        return
    fi
    echo "Tracked shows:"
    while IFS=$'\t' read -r tmdb_id show_name season ep pos; do
        local label="S${season}E${ep}"
        [[ "${pos:-0}" -gt 0 ]] 2>/dev/null && label+=" ($(fmt_pos "$pos"))"
        printf '  %-30s  %s\n' "$show_name" "$label"
    done < "$HISTORY_FILE"
}

cmd_remove() {
    [[ -z "$1" ]] && die "Usage: krono-cli --remove <tmdb_id>"
    history_del "$1"
    info "Removed $1 from history"
}

cmd_search() {
    local query="$*"
    [[ -z "$query" ]] && read -rp "Search: " query
    [[ -z "$query" ]] && exit 0

    info "Searching for '${query}'..."
    local results
    results=$(tmdb_search "$query")
    [[ -z "$results" ]] && die "No results found"

    local chosen
    chosen=$(echo "$results" | fzf --prompt="Select show: " --height=20 --reverse --delimiter=$'\t' --with-nth=2)
    [[ -z "$chosen" ]] && exit 0

    local tmdb_id show_name
    tmdb_id=$(echo "$chosen" | cut -f1)
    show_name=$(echo "$chosen" | cut -f2)

    # Check history
    local saved
    saved=$(history_get "$tmdb_id")
    if [[ -n "$saved" ]]; then
        local saved_s saved_e saved_pos
        saved_s=$(echo "$saved" | cut -f2)
        saved_e=$(echo "$saved" | cut -f3)
        saved_pos=$(echo "$saved" | cut -f4)
        local resume_msg="S${saved_s}E${saved_e}"
        [[ "${saved_pos:-0}" -gt 0 ]] 2>/dev/null && resume_msg+=" at $(fmt_pos "$saved_pos")"
        read -rp "Continue '${show_name}' from ${resume_msg}? [Y/n] " cont
        if [[ "${cont,,}" != "n" ]]; then
            play_episode "$tmdb_id" "$show_name" "$saved_s" "$saved_e" "$saved_pos"
            return
        fi
    fi

    # Pick episode manually
    local pick_file; pick_file=$(mktemp)
    pick_episode "$tmdb_id" "$pick_file" || { rm -f "$pick_file"; exit 0; }
    local picked; picked=$(cat "$pick_file"); rm -f "$pick_file"
    [[ -z "$picked" ]] && exit 0
    local s e
    s=$(echo "$picked" | cut -d' ' -f1)
    e=$(echo "$picked" | cut -d' ' -f2)

    play_episode "$tmdb_id" "$show_name" "$s" "$e"
}

# ── main ──────────────────────────────────────────────────────────────────────
dep_check

case "$1" in
    --list|-l)    cmd_list ;;
    --remove|-r)  cmd_remove "$2" ;;
    --help|-h)
        cat << 'EOF'
krono-cli — stream and track TV shows

Usage:
  krono-cli [show name]         Search and stream a show
  krono-cli --list              Show tracked progress
  krono-cli --remove <tmdb_id>  Remove a show from history

Environment:
  KRONO_PLAYER    Media player (default: mpv)
  KRONO_QUALITY   Preferred quality: 1080p, 720p, 480p, 4K (default: 1080p)
EOF
        ;;
    *)  cmd_search "$@" ;;
esac
