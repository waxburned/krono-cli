# ── MyAnimeList tracking ───────────────────────────────────────────────────────
mal_get_token() {
    [[ ! -f "$MAL_TOKEN_FILE" ]] && return 1
    python3 -c "
import json, time, sys
try:
    d = json.load(open(sys.argv[1]))
    if d.get('expires_at', 0) > time.time():
        print(d['access_token'])
except Exception:
    pass
" "$MAL_TOKEN_FILE"
}

mal_refresh_token() {
    [[ ! -f "$MAL_TOKEN_FILE" ]] && return 1
    local refresh_token client_id
    refresh_token=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('refresh_token',''))" "$MAL_TOKEN_FILE" 2>/dev/null)
    client_id=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('client_id',''))" "$MAL_TOKEN_FILE" 2>/dev/null)
    [[ -z "$refresh_token" || -z "$client_id" ]] && return 1

    local resp
    resp=$(curl -s -X POST "https://myanimelist.net/v1/oauth2/token" \
        --data-urlencode "client_id=${client_id}" \
        --data-urlencode "grant_type=refresh_token" \
        --data-urlencode "refresh_token=${refresh_token}")
    [[ -z "$resp" ]] && return 1

    python3 -c "
import json, time, sys
token = json.loads(sys.argv[1])
if 'access_token' not in token:
    sys.exit(1)
token['expires_at'] = time.time() + token.get('expires_in', 1800)
token['client_id'] = sys.argv[3]
with open(sys.argv[2], 'w') as f:
    json.dump(token, f)
" "$resp" "$MAL_TOKEN_FILE" "$client_id"
}

mal_update_episode() {
    local mal_id="$1" episode="$2"
    [[ -z "$mal_id" || "$mal_id" == "0" || "$mal_id" == "null" ]] && return 0
    local token
    token=$(mal_get_token)
    if [[ -z "$token" ]]; then
        mal_refresh_token || return 0
        token=$(mal_get_token)
        [[ -z "$token" ]] && return 0
    fi
    curl -s -X PUT \
        "https://api.myanimelist.net/v2/anime/${mal_id}/my_list_status" \
        -H "Authorization: Bearer ${token}" \
        --data-urlencode "status=watching" \
        --data-urlencode "num_watched_episodes=${episode}" \
        > /dev/null 2>&1
    [[ "${KRONO_DEBUG:-0}" == "1" ]] && info "[debug] MAL: updated ${mal_id} -> episode ${episode}"
}

